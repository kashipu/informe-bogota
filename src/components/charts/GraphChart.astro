---
interface Props { dataPath: string; }
const { dataPath } = Astro.props;
---
<div class="controls">
  <button id="collapse-btn">Colapsar todo</button>
  <button id="expand-btn">Expandir todo</button>
  <button id="reset-btn">Centrar</button>
</div>
<div id="chart"></div>
<div class="tooltip" id="tooltip"></div>

<style>
  .controls {
    position: fixed;
    top: 84px;
    left: 16px;
    z-index: 50;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .controls button {
    padding: 6px 12px;
    font-size: 12px;
    cursor: pointer;
    border: 1px solid #ccc;
    border-radius: 5px;
    background: #fff;
    color: #333;
    white-space: nowrap;
  }
  .controls button:hover { background: #f0f0f0; }
  .tooltip {
    position: fixed;
    background: rgba(20, 40, 30, 0.95);
    color: #fff;
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 12px;
    pointer-events: none;
    max-width: 320px;
    line-height: 1.5;
    z-index: 200;
    display: none;
  }
  .tooltip strong { color: #4ade80; display: block; margin-bottom: 2px; }
  .node circle { stroke-width: 2px; transition: r 0.15s; }
  .link { fill: none; stroke-opacity: 0.35; stroke-width: 1.5px; }
</style>

<script define:vars={{ dataPath }}>
const COLORS = ['#1a3a2a','#2980b9','#8e44ad','#16a085','#e67e22','#27ae60','#f39c12'];
function getColor(d) { return COLORS[Math.min(d.depth, COLORS.length - 1)]; }
function getR(d) { return d.depth === 0 ? 8 : d.depth === 1 ? 6 : d._children ? 5 : 3.5; }

const width = window.innerWidth;
const height = window.innerHeight;
const dy = (width - 300) / 7;
const tree = d3.tree().nodeSize([20, dy]);

const svg = d3.select('#chart').append('svg')
  .attr('width', width).attr('height', height)
  .style('user-select', 'none');

const zoomG = svg.append('g');
const zoom = d3.zoom().scaleExtent([0.1, 3]).on('zoom', e => zoomG.attr('transform', e.transform));
svg.call(zoom);

const gLink = zoomG.append('g').attr('fill', 'none');
const gNode = zoomG.append('g').attr('cursor', 'pointer').attr('pointer-events', 'all');
const tooltip = d3.select('#tooltip');

d3.json(dataPath).then(data => {
  const root = d3.hierarchy(data);
  root.x0 = height / 2; root.y0 = 0;
  root.descendants().forEach((d, i) => {
    d.id = i; d._children = d.children;
    if (d.depth > 2) d.children = null;
  });

  function update(source) {
    tree(root);
    const nodes = root.descendants().reverse();
    const links = root.links();
    const transition = svg.transition().duration(300);

    const node = gNode.selectAll('g').data(nodes, d => d.id);
    const nodeEnter = node.enter().append('g').attr('class', 'node')
      .attr('transform', () => `translate(${source.y0},${source.x0})`)
      .attr('fill-opacity', 0).attr('stroke-opacity', 0)
      .on('click', (event, d) => { d.children = d.children ? null : d._children; update(d); })
      .on('mousemove', (event, d) => {
        tooltip.style('display', 'block')
          .style('left', (event.clientX + 14) + 'px').style('top', (event.clientY - 10) + 'px')
          .html(`<strong>${d.data.name}</strong><span style="color:#aaa;font-size:10px">profundidad ${d.depth}${d._children ? ` · ${d._children.length} hijos` : ''}</span>`);
      })
      .on('mouseleave', () => tooltip.style('display', 'none'));

    nodeEnter.append('circle')
      .attr('r', getR)
      .attr('fill', getColor)
      .attr('stroke', getColor)
      .attr('stroke-width', 2);

    nodeEnter.append('text').attr('dy', '0.31em')
      .attr('x', d => (d.children || d._children) ? -10 : 10)
      .attr('text-anchor', d => (d.children || d._children) ? 'end' : 'start')
      .style('font-size', d => d.depth === 0 ? '13px' : d.depth === 1 ? '12px' : '10px')
      .style('font-weight', d => d.depth <= 1 ? '600' : d.depth === 2 ? '500' : '400')
      .style('fill', getColor)
      .text(d => d.data.name.length > 40 ? d.data.name.slice(0, 38) + '…' : d.data.name)
      .clone(true).lower()
      .attr('stroke-linejoin', 'round').attr('stroke-width', 3).attr('stroke', 'white');

    node.merge(nodeEnter).transition(transition)
      .attr('transform', d => `translate(${d.y},${d.x})`)
      .attr('fill-opacity', 1).attr('stroke-opacity', 1);
    node.exit().transition(transition).remove()
      .attr('transform', () => `translate(${source.y},${source.x})`)
      .attr('fill-opacity', 0).attr('stroke-opacity', 0);

    const link = gLink.selectAll('path').data(links, d => d.target.id);
    const linkEnter = link.enter().append('path').attr('class', 'link')
      .attr('stroke', d => getColor(d.target))
      .attr('d', () => { const o = {x: source.x0, y: source.y0}; return d3.linkHorizontal()({source: [o.y, o.x], target: [o.y, o.x]}); });

    link.merge(linkEnter).transition(transition)
      .attr('stroke', d => getColor(d.target))
      .attr('d', d => d3.linkHorizontal()({source: [d.source.y, d.source.x], target: [d.target.y, d.target.x]}));
    link.exit().transition(transition).remove()
      .attr('d', d => { const o = {x: source.x, y: source.y}; return d3.linkHorizontal()({source: [o.y, o.x], target: [o.y, o.x]}); });

    root.eachBefore(d => { d.x0 = d.x; d.y0 = d.y; });
  }

  update(root);

  const initialTransform = d3.zoomIdentity.translate(200, height / 2).scale(0.85);
  svg.call(zoom.transform, initialTransform);

  d3.select('#collapse-btn').on('click', () => { root.descendants().forEach(d => { if (d.depth > 0) d.children = null; }); update(root); });
  d3.select('#expand-btn').on('click', () => { root.descendants().forEach(d => { d.children = d._children; }); update(root); });
  d3.select('#reset-btn').on('click', () => { svg.transition().duration(400).call(zoom.transform, initialTransform); });
  window.addEventListener('resize', () => location.reload());
}).catch(error => {
  document.body.innerHTML = `<p style="padding:2rem">Error cargando <code>${dataPath}</code>: ${error}</p>`;
});
</script>
