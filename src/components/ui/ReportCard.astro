---
interface Props { href: string; title: string; description: string; }
const { href, title, description } = Astro.props;
---
<a href={href} class="block bg-brand-gradient rounded-xl p-6 text-center text-white no-underline transition-transform duration-300 hover:-translate-y-1 hover:shadow-xl">
  <h3 class="text-lg font-semibold mt-0 mb-2">{title}</h3>
  <p class="text-sm opacity-90 m-0">{description}</p>
</a>
