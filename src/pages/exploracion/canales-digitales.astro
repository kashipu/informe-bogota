---
// Self-contained D3 tree — data is hardcoded, no external JSON needed
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Canales Digitales — Arquitectura Propuesta</title>
  <script is:inline src="https://d3js.org/d3.v7.min.js"></script>
  <style>
    * { box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; margin: 0; background: #f4f6f9; overflow: hidden; }
    .header { position: fixed; top: 0; left: 0; right: 0; background: #fff; border-bottom: 1px solid #dee2e6; padding: 10px 20px; display: flex; align-items: center; justify-content: space-between; z-index: 100; height: 52px; }
    .header h1 { margin: 0; font-size: 15px; font-weight: 600; color: #1a1a2e; }
    .header-meta { font-size: 12px; color: #6c757d; }
    .controls { display: flex; gap: 8px; align-items: center; }
    button { padding: 5px 12px; font-size: 12px; border: 1px solid #dee2e6; border-radius: 4px; background: #fff; cursor: pointer; color: #495057; }
    button:hover { background: #f8f9fa; }
    .legend { position: fixed; bottom: 16px; left: 16px; background: #fff; border: 1px solid #dee2e6; border-radius: 6px; padding: 10px 14px; font-size: 11px; z-index: 100; }
    .legend-title { font-weight: 600; margin-bottom: 6px; color: #343a40; }
    .legend-item { display: flex; align-items: center; gap: 6px; margin: 3px 0; color: #495057; }
    .legend-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
    #canvas { position: fixed; top: 52px; left: 0; right: 0; bottom: 0; }
    .link { fill: none; stroke: #ced4da; stroke-width: 1.2px; }
    .node { cursor: pointer; }
    .node circle { stroke-width: 1.8px; }
    .node text { font-size: 11px; dominant-baseline: middle; fill: #212529; }
    .tooltip { position: fixed; background: #212529; color: #fff; padding: 6px 10px; border-radius: 4px; font-size: 11px; pointer-events: none; opacity: 0; transition: opacity 0.15s; z-index: 200; }
  </style>
</head>
<body>
<div class="header">
  <h1>Canales — Arquitectura Propuesta · Banco de Bogotá</h1>
  <div class="controls">
    <a href="/" style="font-size:12px;color:#495057;text-decoration:none;border:1px solid #dee2e6;border-radius:4px;padding:5px 10px;background:#fff;">← Inicio</a>
    <span class="header-meta">Click en nodo para expandir/colapsar</span>
    <button onclick="expandAll()">Expandir todo</button>
    <button onclick="collapseToLevel(2)">Colapsar nivel 2</button>
    <button onclick="resetZoom()">Centrar</button>
  </div>
</div>
<svg id="canvas"></svg>
<div class="legend">
  <div class="legend-title">Tipo de canal</div>
  <div class="legend-item"><div class="legend-dot" style="background:#1971c2"></div> Raíz / Segmento</div>
  <div class="legend-item"><div class="legend-dot" style="background:#2f9e44"></div> Canal Digital</div>
  <div class="legend-item"><div class="legend-dot" style="background:#e67700"></div> Canal Físico</div>
  <div class="legend-item"><div class="legend-dot" style="background:#9c36b5"></div> Canal Asistido</div>
  <div class="legend-item"><div class="legend-dot" style="background:#c92a2a"></div> Corporate</div>
  <div class="legend-item"><div class="legend-dot" style="background:#495057"></div> Contenido / Hoja</div>
</div>
<div class="tooltip" id="tooltip"></div>

<script is:inline>
const treeData = {

  name: "canales", label: "Canales", type: "root",
  children: [
    { name: "personas", label: "Personas", type: "segment", children: [
      { name: "canales-digitales", label: "Canales Digitales", type: "digital", children: [
        { name: "banca-movil", label: "Banca Móvil", type: "digital", children: [
          { name: "landing", label: "(landing — qué es, descarga)", type: "leaf" },
          { name: "instructivos", label: "Instructivos", type: "digital", children: [
            { name: "pagos", label: "Pagos", type: "leaf" }, { name: "transferencias", label: "Transferencias y Utilizaciones", type: "leaf" },
            { name: "compras", label: "Compras", type: "leaf" }, { name: "consultas-extractos", label: "Consultas y Extractos", type: "leaf" },
            { name: "inscripciones", label: "Inscripción Cuentas y Servicios", type: "leaf" }, { name: "programacion-pagos", label: "Programación de Pagos", type: "leaf" },
            { name: "recarga-pse", label: "Recarga Cuenta / PSE", type: "leaf" }, { name: "bloqueos", label: "Bloqueos", type: "leaf" },
