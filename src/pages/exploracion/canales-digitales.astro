            { name: "pagos", label: "Pagos", type: "leaf" }, { name: "transferencias", label: "Transferencias", type: "leaf" }, { name: "consultas", label: "Consultas", type: "leaf" }
          ]},
          { name: "multifuncional", label: "Cajero Multifuncional", type: "leaf" }
        ]},
        { name: "corresponsales", label: "Corresponsales", type: "physical", children: [
