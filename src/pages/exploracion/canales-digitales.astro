          ]},
          { name: "como-activar", label: "Cómo Activar", type: "leaf" }, { name: "seguridad", label: "Seguridad y Token", type: "leaf" }, { name: "preguntas-frecuentes", label: "Preguntas Frecuentes", type: "leaf" }
        ]},
        { name: "banca-virtual", label: "Banca Virtual", type: "digital", children: [
          { name: "landing", label: "(landing — qué es, ingreso)", type: "leaf" },
          { name: "instructivos", label: "Instructivos", type: "digital", children: [
            { name: "pagos", label: "Pagos", type: "leaf" }, { name: "transferencias", label: "Transferencias y Utilizaciones", type: "leaf" },
            { name: "compras", label: "Compras", type: "leaf" }, { name: "consultas-extractos", label: "Consultas y Extractos", type: "leaf" },
            { name: "inscripciones", label: "Inscripción Cuentas y Servicios", type: "leaf" }, { name: "programacion-pagos", label: "Programación de Pagos", type: "leaf" },
            { name: "recarga-pse", label: "Recarga Cuenta / PSE", type: "leaf" }, { name: "bloqueos", label: "Bloqueos", type: "leaf" }, { name: "click-to-pay", label: "Click to Pay", type: "leaf" }
          ]},
          { name: "como-registrarse", label: "Cómo Registrarse ←migra instructivos", type: "leaf" }, { name: "seguridad", label: "Seguridad y Clave", type: "leaf" }, { name: "preguntas-frecuentes", label: "Preguntas Frecuentes", type: "leaf" }
        ]}
