          { name: "beneficios", label: "Beneficios", type: "leaf" }, { name: "como-ser", label: "Cómo Ser Corresponsal", type: "leaf" }
        ]}
      ]},
      { name: "canales-asistidos", label: "Canales Asistidos", type: "assisted", children: [
        { name: "whatsapp-bre-b", label: "WhatsApp — BRE-B", type: "assisted", children: [
          { name: "landing", label: "(landing — qué es BRE-B)", type: "leaf" },
          { name: "instructivos", label: "Instructivos ←migra atencion-cliente", type: "assisted", children: [
            { name: "bre-b-en-whatsapp", label: "BRE-B en WhatsApp", type: "leaf" }, { name: "uso-de-bre-b", label: "Uso de BRE-B", type: "leaf" },
            { name: "consultas", label: "Consultas", type: "leaf" }, { name: "pagos", label: "Pagos", type: "leaf" }, { name: "transferencias", label: "Transferencias", type: "leaf" }
          ]},
          { name: "preguntas-frecuentes", label: "Preguntas Frecuentes", type: "leaf" }
        ]},
        { name: "servilinea", label: "Servilínea ★ nuevo", type: "assisted", children: [
