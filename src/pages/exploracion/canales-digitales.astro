            { name: "pagos", label: "Pagos", type: "leaf" }, { name: "solicitudes", label: "Solicitudes", type: "leaf" }
          ]},
          { name: "horarios", label: "Horarios y Contacto", type: "leaf" }
        ]},
        { name: "asistente", label: "Asistente ★ nuevo", type: "assisted", children: [
          { name: "landing", label: "(landing)", type: "leaf" },
          { name: "instructivos", label: "Instructivos", type: "assisted", children: [
            { name: "que-puede-hacer", label: "Qué puede hacer", type: "leaf" }, { name: "como-activarlo", label: "Cómo activarlo", type: "leaf" }
          ]},
          { name: "preguntas-frecuentes", label: "Preguntas Frecuentes", type: "leaf" }
        ]}
      ]}
    ]},
    { name: "empresas", label: "Empresas", type: "segment", children: [
      { name: "canales-digitales", label: "Canales Digitales", type: "digital", children: [
        { name: "banca-movil-empresas", label: "Banca Móvil Empresas", type: "digital", children: [
          { name: "landing", label: "(landing)", type: "leaf" },
          { name: "instructivos", label: "Instructivos", type: "digital", children: [
            { name: "como-descargar", label: "Cómo Descargar y Activar", type: "leaf" }, { name: "pagos", label: "Pagos", type: "leaf" },
            { name: "transferencias", label: "Transferencias", type: "leaf" }, { name: "consultas", label: "Consultas", type: "leaf" }
          ]},
          { name: "preguntas-frecuentes", label: "Preguntas Frecuentes", type: "leaf" }
        ]},
        { name: "banca-virtual-empresas", label: "Banca Virtual Empresas", type: "digital", children: [
          { name: "landing", label: "(landing)", type: "leaf" },
          { name: "instructivos", label: "Instructivos ←migra /empresas/portales/", type: "digital", children: [
            { name: "configuracion", label: "Configuración", type: "digital", children: [
              { name: "primer-ingreso", label: "Primer Ingreso al Portal", type: "leaf" }, { name: "ajuste-contrasena", label: "Ajuste de Contraseña", type: "leaf" },
              { name: "config-usuarios", label: "Configuración de Usuarios", type: "leaf" }, { name: "limites-usuario", label: "Límites de Usuario", type: "leaf" }, { name: "config-horarios", label: "Configuración Horarios", type: "leaf" }
            ]},
            { name: "transferencias", label: "Transferencias", type: "digital", children: [
              { name: "a-terceros", label: "A Terceros", type: "leaf" }, { name: "internas", label: "Internas", type: "leaf" }, { name: "inversion-externa", label: "Inversión Externa", type: "leaf" }
            ]},
            { name: "pagos", label: "Pagos", type: "digital", children: [
              { name: "pago-servicios", label: "Pago de Servicios", type: "leaf" }, { name: "impuestos-dian", label: "Impuestos DIAN", type: "leaf" },
              { name: "impuestos-distritales", label: "Impuestos Distritales", type: "leaf" }, { name: "pagos-masivos", label: "Estructura Pagos Masivos", type: "leaf" },
              { name: "pago-afc", label: "Pago a Cuentas AFC", type: "leaf" }, { name: "consultas-pagos-pse", label: "Consultas y Pagos PSE", type: "leaf" }
            ]},
            { name: "consultas", label: "Consultas", type: "digital", children: [
              { name: "extractos", label: "Extractos", type: "leaf" }, { name: "facturacion", label: "Facturación", type: "leaf" },
              { name: "docs-libranza-factoring", label: "Documentos Libranza / Factoring", type: "leaf" }, { name: "listado-bancos", label: "Listado de Bancos", type: "leaf" }
            ]},
            { name: "otras-operaciones", label: "Otras Operaciones", type: "digital", children: [
              { name: "cheques", label: "Activación de Cheques", type: "leaf" }, { name: "dispersion-fondos", label: "Dispersión de Fondos", type: "leaf" },
              { name: "domiciliacion", label: "Débitos / Domiciliación", type: "leaf" }, { name: "alertas", label: "Alertas", type: "leaf" },
              { name: "credito-rotativo", label: "Crédito Rotativo", type: "leaf" }, { name: "archivos-pgp", label: "Validación Archivos PGP", type: "leaf" }
            ]}
          ]},
          { name: "preguntas-frecuentes", label: "Preguntas Frecuentes", type: "leaf" }
        ]}
      ]},
      { name: "canales-fisicos", label: "Canales Físicos", type: "physical", children: [
        { name: "oficinas-emp", label: "Oficinas", type: "physical", children: [
          { name: "red-oficinas", label: "Red de Oficinas", type: "leaf" }, { name: "tipos", label: "Tipos de Oficina", type: "leaf" }, { name: "servicios", label: "Servicios Disponibles", type: "leaf" }
        ]},
        { name: "cajeros-emp", label: "Cajeros", type: "physical", children: [
          { name: "red-cajeros", label: "Red de Cajeros", type: "leaf" }, { name: "instructivos", label: "Instructivos", type: "leaf" }, { name: "multifuncional", label: "Cajero Multifuncional", type: "leaf" }
        ]},
        { name: "corresponsales-emp", label: "Corresponsales", type: "physical", children: [
          { name: "que-es", label: "Qué es", type: "leaf" }, { name: "instructivos", label: "Instructivos", type: "leaf" }
        ]}
      ]},
      { name: "canales-asistidos", label: "Canales Asistidos", type: "assisted", children: [
        { name: "whatsapp-emp", label: "WhatsApp — BRE-B", type: "assisted", children: [
          { name: "landing", label: "(landing)", type: "leaf" }, { name: "instructivos", label: "Instructivos", type: "leaf" }, { name: "preguntas-frecuentes", label: "Preguntas Frecuentes", type: "leaf" }
        ]},
        { name: "servilinea-emp", label: "Servilínea ★ nuevo", type: "assisted", children: [
          { name: "landing", label: "(landing)", type: "leaf" }, { name: "instructivos", label: "Instructivos", type: "leaf" }, { name: "horarios", label: "Horarios y Contacto", type: "leaf" }
        ]},
        { name: "asistente-emp", label: "Asistente ★ nuevo", type: "assisted", children: [
          { name: "landing", label: "(landing)", type: "leaf" }, { name: "instructivos", label: "Instructivos", type: "leaf" }
        ]}
      ]},
      { name: "corporate", label: "Corporate", type: "corporate", children: [
        { name: "avalpay-center-empresa", label: "AvalPay Center Empresa", type: "corporate", children: [
          { name: "landing", label: "Qué es", type: "leaf" }, { name: "instructivos", label: "Instructivos", type: "leaf" }, { name: "preguntas-frecuentes", label: "Preguntas Frecuentes", type: "leaf" }
        ]},
        { name: "acceso-soporte", label: "Acceso y Soporte", type: "leaf" }
      ]}
    ]}
  ]
};

const COLORS = {
  root: "#1971c2", segment: "#1971c2",
  digital: "#2f9e44", physical: "#e67700",
  assisted: "#9c36b5", corporate: "#c92a2a",
  leaf: "#adb5bd"
};
function getColor(d) { return COLORS[d.data.type] || COLORS.leaf; }
function getR(d) { return d.depth === 0 ? 8 : d.depth === 1 ? 6 : (d._children || d.children) ? 5 : 3.5; }

const svg = d3.select("#canvas");
let width = window.innerWidth, height = window.innerHeight - 52;
svg.attr("width", width).attr("height", height).style("user-select", "none");
const zoomG = svg.append("g");
const zoom = d3.zoom().scaleExtent([0.1, 3]).on("zoom", e => zoomG.attr("transform", e.transform));
svg.call(zoom);
const gLink = zoomG.append("g").attr("fill", "none");
const gNode = zoomG.append("g").attr("cursor", "pointer").attr("pointer-events", "all");
const tooltip = document.getElementById("tooltip");

const treeLayout = d3.tree().nodeSize([22, 200]);
const root = d3.hierarchy(treeData);
root.x0 = height / 2; root.y0 = 0;
root.descendants().forEach((d, i) => {
  d.id = i; d._children = d.children;
  if (d.depth >= 2) d.children = null;
});

function update(source) {
  treeLayout(root);
  const nodes = root.descendants().reverse();
  const links = root.links();
  const t = svg.transition().duration(300);

  const node = gNode.selectAll("g").data(nodes, d => d.id);
  const nodeEnter = node.enter().append("g")
    .attr("transform", () => `translate(${source.y0},${source.x0})`)
    .attr("fill-opacity", 0).attr("stroke-opacity", 0)
    .on("click", (event, d) => { d.children = d.children ? null : d._children; update(d); })
    .on("mousemove", (event, d) => {
      tooltip.style.display = "block";
      tooltip.style.left = (event.clientX + 14) + "px";
      tooltip.style.top = (event.clientY - 10) + "px";
      tooltip.innerHTML = `<strong style="color:#fff;display:block">${d.data.label || d.data.name}</strong><span style="color:#aaa;font-size:10px">${d.data.type}${d._children ? " · " + d._children.length + " hijos" : ""}</span>`;
    })
    .on("mouseleave", () => { tooltip.style.display = "none"; });

  nodeEnter.append("circle")
    .attr("r", getR).attr("fill", getColor).attr("stroke", getColor).attr("stroke-width", 2);

  nodeEnter.append("text").attr("dy", "0.31em")
    .attr("x", d => (d.children || d._children) ? -10 : 10)
    .attr("text-anchor", d => (d.children || d._children) ? "end" : "start")
    .style("font-size", d => d.depth === 0 ? "13px" : d.depth === 1 ? "12px" : "10px")
    .style("font-weight", d => d.depth <= 1 ? "600" : "400")
    .style("fill", getColor)
    .text(d => { const l = d.data.label || d.data.name; return l.length > 38 ? l.slice(0, 36) + "…" : l; })
    .clone(true).lower()
    .attr("stroke-linejoin", "round").attr("stroke-width", 3).attr("stroke", "white");

  node.merge(nodeEnter).transition(t)
    .attr("transform", d => `translate(${d.y},${d.x})`)
    .attr("fill-opacity", 1).attr("stroke-opacity", 1);
  node.exit().transition(t).remove()
    .attr("transform", () => `translate(${source.y},${source.x})`)
    .attr("fill-opacity", 0).attr("stroke-opacity", 0);

  const link = gLink.selectAll("path").data(links, d => d.target.id);
  const linkEnter = link.enter().append("path")
    .attr("stroke", d => getColor(d.target)).attr("stroke-opacity", 0.35).attr("stroke-width", 1.5)
    .attr("d", () => { const o = { x: source.x0, y: source.y0 }; return d3.linkHorizontal()({ source: [o.y, o.x], target: [o.y, o.x] }); });
  link.merge(linkEnter).transition(t)
    .attr("d", d => d3.linkHorizontal()({ source: [d.source.y, d.source.x], target: [d.target.y, d.target.x] }));
  link.exit().transition(t).remove()
    .attr("d", d => { const o = { x: source.x, y: source.y }; return d3.linkHorizontal()({ source: [o.y, o.x], target: [o.y, o.x] }); });

  root.eachBefore(d => { d.x0 = d.x; d.y0 = d.y; });
}

const initialTransform = d3.zoomIdentity.translate(160, height / 2).scale(0.9);

function expandAll() {
  root.descendants().forEach(d => { d.children = d._children; });
  update(root); svg.transition().duration(400).call(zoom.transform, initialTransform);
}
function collapseToLevel(level) {
  root.descendants().forEach(d => {
    if (d.depth >= level) d.children = null; else d.children = d._children;
  });
  update(root); svg.transition().duration(400).call(zoom.transform, initialTransform);
}
function resetZoom() { svg.transition().duration(400).call(zoom.transform, initialTransform); }

update(root);
svg.call(zoom.transform, initialTransform);
window.addEventListener("resize", () => location.reload());
</script>
</body>
</html>
