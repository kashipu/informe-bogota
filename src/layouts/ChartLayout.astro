---
interface Props {
  title: string;
  activeChart: string;
  prefix?: string;
}
const { title, activeChart, prefix = '' } = Astro.props;

const chartLinks = [
  { href: `/${prefix}grafico`, label: 'Árbol', id: 'grafico' },
  { href: `/${prefix}icicle`, label: 'Jerarquía', id: 'icicle' },
  { href: `/${prefix}pack`, label: 'Concentración', id: 'pack' },
];

const backHref = prefix ? '/nowps' : '/';
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <script is:inline src="https://d3js.org/d3.v7.min.js"></script>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      margin: 0;
      background-color: #f8f9fa;
      overflow: hidden;
    }
    .main-header {
      background-color: #fff;
      border-bottom: 1px solid #dee2e6;
      position: absolute;
      top: 0; left: 0; right: 0;
      z-index: 20;
      box-sizing: border-box;
    }
    .main-header .top-row {
      padding: 8px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid #f0f0f0;
    }
    .main-header h1 { margin: 0; font-size: 15px; color: #343a40; font-weight: 600; }
    .main-header .nav-row {
      padding: 4px 16px;
      display: flex;
      flex-wrap: wrap;
      gap: 2px;
      align-items: center;
      font-size: 12px;
    }
    .main-header nav a {
      text-decoration: none;
      color: #495057;
      padding: 3px 8px;
      border-radius: 4px;
    }
    .main-header nav a:hover { background: #f8f9fa; }
    .main-header nav a.active { background-color: #007bff; color: #fff; }
    /* dropdown nav */
    .nav-row { padding: 4px 16px; display: flex; align-items: center; gap: 2px; font-size: 12px; }
    .nav-row > a { text-decoration: none; color: #495057; padding: 3px 8px; border-radius: 4px; white-space: nowrap; }
    .nav-row > a:hover { background: #f8f9fa; }
    .dd { position: relative; }
    .dd-btn {
      display: flex; align-items: center; gap: 3px;
      padding: 3px 8px; font-size: 12px; color: #495057;
      background: none; border: none; border-radius: 4px; cursor: pointer; white-space: nowrap;
    }
    .dd-btn:hover { background: #f8f9fa; }
    .dd-btn .ch { font-size: 9px; opacity: 0.5; }
    .dd-menu {
      display: none; position: absolute; top: calc(100% + 4px); left: 0;
      background: #fff; border: 1px solid #e5e7eb; border-radius: 8px;
      box-shadow: 0 4px 16px rgba(0,0,0,0.1); min-width: 190px; z-index: 100; padding: 4px;
    }
    .dd:hover .dd-menu { display: block; }
    .dd-menu::before { content: ''; position: absolute; top: -8px; left: 0; right: 0; height: 8px; }
    .dd-menu a { display: block; padding: 6px 10px; font-size: 12px; color: #374151; text-decoration: none; border-radius: 5px; }
    .dd-menu a:hover { background: #f3f4f6; }
    .dd-sep { border: none; border-top: 1px solid #e5e7eb; margin: 3px 0; }
    .chart-area {
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      overflow: hidden;
      padding-top: 74px;
    }
    .tooltip {
      position: absolute;
      padding: 8px;
      font: 12px sans-serif;
      background: #fff;
      border: 1px solid #ccc;
      border-radius: 8px;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.2s;
      max-width: 400px;
      word-wrap: break-word;
      z-index: 50;
    }
  </style>
</head>
<body>
  <header class="main-header">
    <div class="top-row">
      <h1>📊 Arquitectura del Sitio{prefix ? ' — Filtrado' : ''}</h1>
      <nav>
        {chartLinks.map(l => (
          <a href={l.href} class={activeChart === l.id ? 'active' : ''}>{l.label}</a>
        ))}
      </nav>
    </div>
    <div class="nav-row">
      <a href="/">🏠 Inicio</a>

      <div class="dd">
        <button class="dd-btn">📋 Datos <span class="ch">▾</span></button>
        <div class="dd-menu">
          <a href="/insights">🔍 Insights</a>
          <a href="/redirects">🔁 Redirecciones</a>
        </div>
      </div>

      <div class="dd">
        <button class="dd-btn">🌐 Vistas <span class="ch">▾</span></button>
        <div class="dd-menu">
          <a href="/grafico">🌳 Árbol</a>
          <a href="/icicle">📊 Jerarquía</a>
          <a href="/pack">⭕ Concentración</a>
        </div>
      </div>

      <div class="dd">
        <button class="dd-btn">✨ Filtrado <span class="ch">▾</span></button>
        <div class="dd-menu">
          <a href="/nowps">🏠 Dashboard</a>
          <hr class="dd-sep" />
          <a href="/nowps/grafico">🌳 Árbol</a>
          <a href="/nowps/icicle">📊 Jerarquía</a>
          <a href="/nowps/pack">⭕ Concentración</a>
        </div>
      </div>

      <div class="dd">
        <button class="dd-btn">🗺️ Exploración <span class="ch">▾</span></button>
        <div class="dd-menu">
          <a href="/exploracion/canales-digitales">📡 Canales Digitales</a>
          <a href="/exploracion/tarjetas/tc-actual">💳 Tarjetas — Actual</a>
          <a href="/exploracion/tarjetas/tc-propuesta">💳 Tarjetas — Propuesta</a>
        </div>
      </div>
    </div>
  </header>

  <div class="chart-area">
    <slot />
  </div>

  <div class="tooltip" id="global-tooltip"></div>
</body>
</html>
